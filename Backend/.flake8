[flake8]
max-line-length = 100

exclude =
    .git,
    __pycache__,
    migrations,
    Venv,
    venv,
    .venv,
    static,
    staticfiles,
    manage.py

# extend-ignore, not ignore: `ignore` REPLACES flake8's defaults, which would switch W503/E203
# back on. Both fire on formatting that black produces, so they must stay off.
#   W503 line break before a binary operator
#   E203 whitespace before ':'
#   F401 imported but unused — the settings are assembled from star-imports
extend-ignore = W503, E203, F401

per-file-ignores =
    config/django/*.py: F403, F405
    config/settings_modules/__init__.py: F403
