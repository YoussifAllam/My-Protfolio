# Copy this file to .env.local (or .env.test / .env.prod) and fill it in.
# The name after the dot must match the ENVIRONMENT value below — config/env.py loads
# ENV/.env.$ENVIRONMENT and refuses to start if that file is missing.
#
# NEVER commit a filled-in copy. The .env.* files are gitignored for exactly this reason.

# ── Core ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=True

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-random-value

DJANGO_BASE_BACKEND_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS & CSRF ─────────────────────────────────────────────────────────────────
# Where your frontend is served from. Credentials are allowed, so these must be exact
# origins — "*" will not work with cookie auth.
# front/ runs its Vite dev server on 8443 by default (see front/AGENTS.md) — not
# Vite's usual 5173. Both are listed here alongside 3000 so either convention works.
DJANGO_CORS_ORIGIN_WHITELIST=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443

# ── Auth cookies ────────────────────────────────────────────────────────────────
# Secure defaults to "not DEBUG"; force it here if you terminate TLS upstream.
# AUTH_COOKIE_SECURE=True
# "Lax" when the site and API share a domain. Set None (and Secure=True) for a
# cross-site frontend.
# AUTH_COOKIE_SAMESITE=Lax

# ── JWT lifetimes ───────────────────────────────────────────────────────────────
# ACCESS_TOKEN_LIFETIME_MINUTES=15
# REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Localisation ────────────────────────────────────────────────────────────────
# LANGUAGE_CODE=en
# TIME_ZONE=UTC

# ── Database ────────────────────────────────────────────────────────────────────
# Local dev uses SQLite and needs nothing here. Set these for ENVIRONMENT=test:
# test_DATABASE_ENGINE=django.db.backends.postgresql
# test_DATABASE_NAME=
# test_DATABASE_USER=
# test_DATABASE_PASSWORD=
# test_DATABASE_HOST=127.0.0.1
# test_DATABASE_PORT=5432
#
# ...and these for ENVIRONMENT=Production:
# PROD_DATABASE_ENGINE=django.db.backends.postgresql
# PROD_DATABASE_NAME=
# PROD_DATABASE_USER=
# PROD_DATABASE_PASSWORD=
# PROD_DATABASE_HOST=
# PROD_DATABASE_PORT=5432

# ── One-time codes (phone login) ────────────────────────────────────────────────
# Accepted phone shape. Default is E.164; narrow it per country if you like.
# PHONE_REGEX=^\+?[1-9]\d{7,14}$
# Country code assumed when a number is typed locally ("07..."). Blank = no rewriting.
# PHONE_COUNTRY_CODE=

# While DEBUG is on, codes are printed to the console instead of sent, and the pool
# codes below are accepted for any number. Both flip off automatically in production.
# OTP_DEV_POOL=123456,000000
# OTP_DEV_POOL_ALWAYS_ACCEPTED=False
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=60

# ── SMS gateway (production only) ───────────────────────────────────────────────
# Leave OTP_PROVIDER_CLASS unset to get the console provider on DEBUG and the SMS one
# otherwise. Point it at your own class to use a gateway that isn't a plain HTTP GET.
# OTP_PROVIDER_CLASS=apps.registration.services.providers.SMSOTPProvider
# SMS_OTP_ENABLED=True
# SMS_OTP_ENDPOINT=
# SMS_OTP_SENDER=
# SMS_OTP_ACC_NAME=
# SMS_OTP_ACC_PASS=
# SMS_OTP_MESSAGE_TEMPLATE=Your verification code is: {code}

# ── Email ───────────────────────────────────────────────────────────────────────
# Optional: without these, mail is printed to the console instead of sent.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Comma-separated "Name <address>" pairs that receive 500-error mail.
# DJANGO_ADMINS=Ops <ops@example.com>

# ── Production transport security ───────────────────────────────────────────────
# All default to the secure value. Turn them off only for a plain-HTTP deployment.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
